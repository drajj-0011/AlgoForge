# Local MongoDB (recommended)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=algoforge

# Optional: PostgreSQL fallback used only when MONGODB_URI is absent
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: enables the neural analyst; the deterministic analyst works without it
# OPENAI_API_KEY=
